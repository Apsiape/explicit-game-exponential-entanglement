def evalWith (assignments : List WordBlock) (w : Word) : WordBlock :=
  w.foldl (fun b a =>
    let v := assignments[a.1-1]?.getD ⟨false,[],[]⟩
    blockMul b (if a.2 then v else blockInv v)) ⟨false,[],[]⟩
def blockWords (assignments : List WordBlock) (relators : List Word) : List Word :=
  relators.flatMap (fun w => let b := evalWith assignments w; [b.first,b.second])
