import Companion.Kernel
namespace Companion
structure WordBlock where
  swapped : Bool
  first : Word
  second : Word
  deriving DecidableEq
def blockMul (a b : WordBlock) : WordBlock :=
  ⟨Bool.xor a.swapped b.swapped,
    a.first ++ (if a.swapped then b.second else b.first),
    a.second ++ (if a.swapped then b.first else b.second)⟩
def blockInv (a : WordBlock) : WordBlock :=
  ⟨a.swapped,FreeGroup.invRev (if a.swapped then a.second else a.first),
    FreeGroup.invRev (if a.swapped then a.first else a.second)⟩
def gadgetAssignments : List WordBlock := [⟨false, [(1, true)], [(1, true)]⟩, ⟨false, [(2, true)], [(2, true)]⟩, ⟨false, [(3, true)], [(3, true)]⟩, ⟨true, [(1, true)], [(1, true)]⟩, ⟨true, [], []⟩, ⟨true, [(2, true)], [(2, true)]⟩, ⟨true, [(2, true), (1, true)], [(1, true), (2, true)]⟩, ⟨false, [(2, true), (1, true), (2, true)], [(1, true)]⟩, ⟨false, [(2, true), (3, true)], []⟩, ⟨false, [(2, true)], [(3, true)]⟩]
def gadgetBlockRelators : List Word := [[(1, true), (1, true)], [(2, true), (2, true)], [(3, true), (3, true)], [(4, true), (4, true)], [(5, true), (5, true)], [(6, true), (6, true)], [(7, true), (7, true)], [(8, true), (8, true)], [(9, true), (9, true)], [(10, true), (10, true)], [(1, true), (4, true), (5, true)], [(2, true), (5, true), (6, true)], [(6, true), (7, true), (8, true)], [(1, true), (8, true), (9, true)], [(3, true), (9, true), (10, true)], [(4, true), (7, true), (10, true)], [(1, true), (4, true), (1, false), (4, false)], [(1, true), (5, true), (1, false), (5, false)], [(4, true), (5, true), (4, false), (5, false)], [(2, true), (5, true), (2, false), (5, false)], [(2, true), (6, true), (2, false), (6, false)], [(5, true), (6, true), (5, false), (6, false)], [(6, true), (7, true), (6, false), (7, false)], [(6, true), (8, true), (6, false), (8, false)], [(7, true), (8, true), (7, false), (8, false)], [(1, true), (8, true), (1, false), (8, false)], [(1, true), (9, true), (1, false), (9, false)], [(8, true), (9, true), (8, false), (9, false)], [(3, true), (9, true), (3, false), (9, false)], [(3, true), (10, true), (3, false), (10, false)], [(9, true), (10, true), (9, false), (10, false)], [(4, true), (7, true), (4, false), (7, false)], [(4, true), (10, true), (4, false), (10, false)], [(7, true), (10, true), (7, false), (10, false)]]
def evalBlock (w : Word) : WordBlock := w.foldl (fun b a =>
  let v := gadgetAssignments[a.1-1]?.getD ⟨false,[],[]⟩
  blockMul b (if a.2 then v else blockInv v)) ⟨false,[],[]⟩
def gadgetBlockWords : List Word := gadgetBlockRelators.flatMap (fun w =>
  let v := evalBlock w
  [v.first,v.second])
def gadgetBaseRelator : RelKey → Option Word
  | .square j => if j<3 then some [pos j,pos j] else none
  | .conjugacy 0 => some [(1,true),(2,true),(1,true),(3,false)]
  | .conjugacy 1 => some [(2,true),(3,true),(2,false),(3,false)]
  | _ => none
