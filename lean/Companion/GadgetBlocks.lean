set_option maxRecDepth 100000
set_option maxHeartbeats 0
theorem gadget_blocks_diagonal : gadgetBlockRelators.all (fun w => !(evalBlock w).swapped)=true := by decide +kernel
theorem gadget_block_targets : gadgetBlockCertificates.map Prod.fst=gadgetBlockWords := by decide +kernel
theorem gadget_block_checks : gadgetBlockCertificates.all
    (fun c => checkWith gadgetBaseRelator c.1 c.2 3)=true := by decide +kernel
theorem gadget_block_areas : ∀ w ∈ gadgetBlockWords, HasAreaWith gadgetBaseRelator w 3 := by
  intro w hw
  rw [← gadget_block_targets] at hw
  obtain ⟨c,hc,he⟩ := List.mem_map.mp hw
  rw [← he]
  exact checkWith_sound (List.all_eq_true.mp gadget_block_checks c hc)
end Companion
